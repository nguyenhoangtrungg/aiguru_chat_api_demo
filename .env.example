# Choose ONE independent model backend. Never commit a real API key.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=REPLACE_WITH_AVAILABLE_MODEL_ID
LLM_API_KEY=REPLACE_WITH_YOUR_KEY
LLM_TIMEOUT_SECONDS=60

# Self-host alternative (replace the active values above):
# LLM_BASE_URL=http://127.0.0.1:18080/v1
# LLM_MODEL=REPLACE_WITH_SERVED_MODEL_ID
# LLM_API_KEY=
# Empty key is allowed only when the self-host server does not require it.
